rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Imagens de perfil: o dono le/escreve a propria pasta.
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- NOVA REGRA PARA LOGOS DE EDITAIS ---
    // Leitura: Todos os usuários logados
    // Escrita: Apenas o ADMIN (OLoJi457GQNE2eTSOcz9DAD6ppZ2)
    match /editais_logos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "OLoJi457GQNE2eTSOcz9DAD6ppZ2";
    }
  }
}
