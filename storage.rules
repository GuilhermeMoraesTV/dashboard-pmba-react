rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLegacyAdmin() {
      return isSignedIn() && request.auth.uid == "OLoJi457GQNE2eTSOcz9DAD6ppZ2";
    }

    function userAccess() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.access;
    }

    function isAdmin() {
      return isLegacyAdmin()
        || (
          isSignedIn()
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && (
            userAccess().permissions.adminPanel == true
            || userAccess().adminRole in ['admin', 'super_admin']
            || userAccess().role == 'admin'
          )
        );
    }

    function isGroupManager(groupId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/study_groups/$(groupId))
        && (
          firestore.get(/databases/(default)/documents/study_groups/$(groupId)).data.ownerId == request.auth.uid
          || (
            firestore.exists(/databases/(default)/documents/study_groups/$(groupId)/members/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/study_groups/$(groupId)/members/$(request.auth.uid)).data.permissions.manageGroup == true
          )
        );
    }

    // Imagens de perfil: o dono le/escreve a propria pasta.
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Identidade visual dos grupos: qualquer usuário autenticado pode exibir,
    // mas somente o dono da pasta pode enviar ou substituir a imagem.
    match /study_group_images/{ownerId}/{groupId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && (request.auth.uid == ownerId || isGroupManager(groupId))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && (request.auth.uid == ownerId || isGroupManager(groupId));
    }

    // --- NOVA REGRA PARA LOGOS DE EDITAIS ---
    // Leitura: Todos os usuários logados
    // Escrita: Apenas o ADMIN (OLoJi457GQNE2eTSOcz9DAD6ppZ2)
    match /editais_logos/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
