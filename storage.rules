rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLegacyAdmin() {
      return isSignedIn() && request.auth.uid == "OLoJi457GQNE2eTSOcz9DAD6ppZ2";
    }

    function userAccess() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('access', {});
    }

    function isAdmin() {
      return isLegacyAdmin()
        || (
          isSignedIn()
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && (
            userAccess().get('permissions', {}).get('adminPanel', false) == true
            || userAccess().get('adminRole', null) in ['admin', 'super_admin']
            || userAccess().get('role', null) == 'admin'
          )
        );
    }

    function isGroupManager(groupId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/study_groups/$(groupId))
        && (
          firestore.get(/databases/(default)/documents/study_groups/$(groupId)).data.ownerId == request.auth.uid
          || (
            firestore.exists(/databases/(default)/documents/study_groups/$(groupId)/members/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/study_groups/$(groupId)/members/$(request.auth.uid)).data.permissions.manageGroup == true
          )
        );
    }

    // Uploads passam obrigatoriamente pela Function uploadSecureImage, que
    // valida os bytes e reencoda o arquivo. O cliente pode apenas ler/excluir
    // o proprio arquivo ja processado.
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if false;
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Identidade visual dos grupos: qualquer usuário autenticado pode exibir,
    // mas somente o dono da pasta pode enviar ou substituir a imagem.
    match /study_group_images/{ownerId}/{groupId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if false;
      allow delete: if isSignedIn() && (request.auth.uid == ownerId || isGroupManager(groupId) || isAdmin());
    }

    // --- NOVA REGRA PARA LOGOS DE EDITAIS ---
    // Leitura: Todos os usuários logados
    // Escrita: Apenas o ADMIN (OLoJi457GQNE2eTSOcz9DAD6ppZ2)
    match /editais_logos/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /broadcasts/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Upload direto de documentos PDF do usuario (isolado por UID)
    match /user_uploads/{userId}/documents/{docId}/{allPaths=**} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf');
      allow update: if false;
    }

    // APKG e enviado diretamente ao Storage e removido pelo backend apos a importacao.
    match /user_uploads/{userId}/anki_imports/{importId}/{fileName} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && fileName.matches('^.+\\.[aA][pP][kK][gG]$')
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType in [
          'application/zip',
          'application/octet-stream',
          'application/x-zip-compressed'
        ];
      allow update: if false;
    }

    // Midias validadas e gravadas exclusivamente pelo Admin SDK.
    match /user_uploads/{userId}/anki_media/{fileName} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if false;
    }
  }
}
