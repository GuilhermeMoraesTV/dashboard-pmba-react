rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mantém a mesma identidade administrativa usada hoje no painel admin.
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin legado por UID fixo, preservado para compatibilidade durante a migração.
    function isLegacyAdmin() {
      return isSignedIn()
        && request.auth.uid == "OLoJi457GQNE2eTSOcz9DAD6ppZ2";
    }

    // Caminho do documento do usuário autenticado.
    function currentUserDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Verifica se o documento do usuário autenticado existe.
    function currentUserDocExists() {
      return isSignedIn() && exists(currentUserDocPath());
    }

    // Retorna os dados do documento do usuário autenticado.
    function currentUserDoc() {
      return get(currentUserDocPath()).data;
    }

    function currentUserAccess() {
      return currentUserDoc().get('access', {});
    }

    function currentUserPermissions() {
      return currentUserAccess().get('permissions', {});
    }

    // Papel administrativo baseado no documento users/{uid}.
    function hasAdminRoleDoc() {
      return currentUserDocExists()
        && (
          currentUserPermissions().get('adminPanel', false) == true
          || currentUserAccess().get('adminRole', null) in ['admin', 'super_admin']
          || currentUserAccess().get('role', null) == 'admin'
        );
    }

    // Admin pode ser o legado por UID ou um usuário com papel administrativo no documento.
    function isAdmin() {
      return isLegacyAdmin() || hasAdminRoleDoc();
    }

    // Verifica se o usuário autenticado é o próprio dono do recurso.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Permite acesso ao dono do recurso ou a um admin.
    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/study_groups/$(groupId);
    }

    function groupMemberPath(groupId, userId) {
      return /databases/$(database)/documents/study_groups/$(groupId)/members/$(userId);
    }

    function isGroupMember(groupId) {
      return isSignedIn() && exists(groupMemberPath(groupId, request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return isSignedIn()
        && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.ownerId == request.auth.uid;
    }

    function isGroupManager(groupId) {
      return isGroupOwner(groupId)
        || (
          isSignedIn()
          && exists(groupMemberPath(groupId, request.auth.uid))
          && get(groupMemberPath(groupId, request.auth.uid)).data.permissions.get('manageGroup', false) == true
        );
    }

    function isGroupMemberManager(groupId) {
      return isGroupOwner(groupId)
        || (
          isSignedIn()
          && exists(groupMemberPath(groupId, request.auth.uid))
          && get(groupMemberPath(groupId, request.auth.uid)).data.permissions.get('manageMembers', false) == true
        );
    }

    function groupManagerUpdateIsSafe() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'description',
          'editalId',
          'editalName',
          'editalLogoURL',
          'cargo',
          'visibility',
          'photoURL',
          'memberCount',
          'updatedAt'
        ]);
    }

    function gamificationProfilePath(userId) {
      return /databases/$(database)/documents/users/$(userId)/gamification/profile;
    }

    function sharesStudyGroup(timerOwnerId) {
      return isSignedIn()
        && exists(gamificationProfilePath(timerOwnerId))
        && exists(gamificationProfilePath(request.auth.uid))
        && get(gamificationProfilePath(timerOwnerId)).data.get('groupIds', [])
          .hasAny(get(gamificationProfilePath(request.auth.uid)).data.get('groupIds', []));
    }

    function gamificationProfileCreateGroupsAreSafe(userId) {
      let groups = request.resource.data.get('groupIds', []);
      let joinedGroupId = request.resource.data.get('lastJoinedGroupId', null);
      return groups.size() == 0
        || (
          joinedGroupId != null
          && groups.size() == 1
          && groups.hasAny([joinedGroupId])
          && existsAfter(groupMemberPath(joinedGroupId, userId))
        );
    }

    function gamificationProfileUpdateGroupsAreSafe(userId) {
      let previousGroups = resource.data.get('groupIds', []);
      let nextGroups = request.resource.data.get('groupIds', []);
      let joinedGroupId = request.resource.data.get('lastJoinedGroupId', null);
      return nextGroups == previousGroups
        || (
          joinedGroupId != null
          && nextGroups.size() == previousGroups.size() + 1
          && nextGroups.hasAll(previousGroups)
          && nextGroups.hasAny([joinedGroupId])
          && existsAfter(groupMemberPath(joinedGroupId, userId))
        );
    }

    function gamificationMainGroupIsSafe(userId) {
      let mainGroupId = request.resource.data.get('mainGroupId', null);
      return mainGroupId == null || existsAfter(groupMemberPath(mainGroupId, userId));
    }

    function gamificationMainGroupUpdateIsSafe(userId) {
      let previousMainGroupId = resource.data.get('mainGroupId', null);
      let nextMainGroupId = request.resource.data.get('mainGroupId', null);
      return nextMainGroupId == previousMainGroupId
        || nextMainGroupId == null
        || existsAfter(groupMemberPath(nextMainGroupId, userId));
    }

    function gamificationProfileCreateKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'groupIds',
        'lastJoinedGroupId',
        'mainGroupId',
        'mainGroupName',
        'createdGroupCount',
        'socialUpdatedAt'
      ]);
    }

    function gamificationProfileUpdateKeysAreSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'groupIds',
        'lastJoinedGroupId',
        'lastRemovedGroupId',
        'mainGroupId',
        'mainGroupName',
        'createdGroupCount',
        'socialUpdatedAt'
      ]);
    }

    function gamificationProfileManagerRemovalIsSafe(userId) {
      let previousGroups = resource.data.get('groupIds', []);
      let nextGroups = request.resource.data.get('groupIds', []);
      let removedGroupId = request.resource.data.get('lastRemovedGroupId', null);
      return removedGroupId != null
        && isGroupMemberManager(removedGroupId)
        && previousGroups.size() == nextGroups.size() + 1
        && previousGroups.hasAll(nextGroups)
        && previousGroups.hasAny([removedGroupId])
        && !nextGroups.hasAny([removedGroupId])
        && !existsAfter(groupMemberPath(removedGroupId, userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'groupIds',
          'lastRemovedGroupId',
          'socialUpdatedAt'
        ]);
    }

    function xpEventReadStateUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
        && request.resource.data.get('isRead', false) == true;
    }

    function notificationReadStateUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'updatedAt'])
        && request.resource.data.get('isRead', false) == true;
    }

    function newGroupMemberRoleIsSafe(groupId) {
      return (
        getAfter(groupPath(groupId)).data.ownerId == request.auth.uid
        && request.resource.data.role == 'owner'
        && request.resource.data.permissions.get('manageGroup', false) == true
      )
      || (
        getAfter(groupPath(groupId)).data.ownerId != request.auth.uid
        && request.resource.data.role == 'member'
        && request.resource.data.permissions.get('manageGroup', false) == false
        && request.resource.data.permissions.get('manageMembers', false) == false
      );
    }

    // Campos que o próprio usuário pode alterar com segurança no documento principal.
    function ownerUserDocTouchedKeysAreSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'email',
        'name',
        'photoURL',
        'coverURL',
        'coverPosition',
        'uid',
        'updatedAt'
      ]);
    }

    function optionalString(data, field, maxLength) {
      let value = data.get(field, null);
      return value == null || (value is string && value.size() <= maxLength);
    }

    function optionalNumberBetween(data, field, minimum, maximum) {
      let value = data.get(field, null);
      return value == null || (value is number && value >= minimum && value <= maximum);
    }

    function optionalListSize(data, field, maximum) {
      let value = data.get(field, null);
      return value == null || (value is list && value.size() <= maximum);
    }

    function ownerUserDocFieldsAreSafe(userId) {
      let data = request.resource.data;
      let coverPosition = data.get('coverPosition', null);
      return optionalString(data, 'displayName', 120)
        && optionalString(data, 'name', 120)
        && optionalString(data, 'email', 320)
        && (data.get('email', null) == null || data.email == request.auth.token.email)
        && (data.get('uid', null) == null || data.uid == userId)
        && (
          !data.keys().hasAny(['photoURL'])
          || data.photoURL == null
          || (data.photoURL is string && data.photoURL.size() <= 2048 && data.photoURL.matches('^https://'))
        )
        && (
          !data.keys().hasAny(['coverURL'])
          || data.coverURL == null
          || (data.coverURL is string && data.coverURL.size() <= 2048 && data.coverURL.matches('^https://firebasestorage\\.googleapis\\.com/.*$'))
        )
        && (
          coverPosition == null
          || (
            coverPosition is map
            && coverPosition.keys().hasOnly(['x', 'y'])
            && optionalNumberBetween(coverPosition, 'x', 0, 100)
            && optionalNumberBetween(coverPosition, 'y', 0, 100)
          )
        );
    }

    function initialStudyStatsAreSafe() {
      let stats = request.resource.data.get('studyStats', null);
      return stats == null
        || (
          stats is map
          && stats.keys().hasOnly(['totalTime', 'completedCycles', 'questionsSolved'])
          && stats.get('totalTime', 0) == 0
          && stats.get('completedCycles', 0) == 0
          && stats.get('questionsSolved', 0) == 0
        );
    }

    function academicIdentityIsSafe(data, userId) {
      return data.get('uid', null) == null || data.uid == userId;
    }

    function academicDateIsSafe(data) {
      let value = data.get('data', null);
      return value == null
        || value is timestamp
        || (value is string && value.matches('^20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]$'));
    }

    function studyRecordIsSafe(userId) {
      let data = request.resource.data;
      let questions = data.get('questoesFeitas', data.get('totalQuestoes', data.get('questions', 0)));
      let correct = data.get('acertos', data.get('questoesAcertadas', data.get('correct', 0)));
      return academicIdentityIsSafe(data, userId)
        && academicDateIsSafe(data)
        && optionalNumberBetween(data, 'tempoEstudadoMinutos', 0, 720)
        && optionalNumberBetween(data, 'duracaoMinutos', 0, 720)
        && optionalNumberBetween(data, 'minutes', 0, 720)
        && optionalNumberBetween(data, 'questoesFeitas', 0, 500)
        && optionalNumberBetween(data, 'totalQuestoes', 0, 500)
        && optionalNumberBetween(data, 'questions', 0, 500)
        && optionalNumberBetween(data, 'acertos', 0, 500)
        && optionalNumberBetween(data, 'questoesAcertadas', 0, 500)
        && optionalNumberBetween(data, 'correct', 0, 500)
        && correct <= questions
        && optionalString(data, 'disciplinaId', 160)
        && optionalString(data, 'disciplinaNome', 200)
        && optionalString(data, 'assunto', 500)
        && optionalString(data, 'obs', 2000)
        && optionalString(data, 'tipoEstudo', 80)
        && optionalString(data, 'tipoRegistro', 80)
        && optionalString(data, 'cicloId', 160)
        && optionalString(data, 'cronogramaId', 160)
        && optionalString(data, 'origemConclusaoId', 240);
    }

    function simulationSummaryIsSafe(data) {
      let summary = data.get('resumo', null);
      return summary == null
        || (
          summary is map
          && optionalNumberBetween(summary, 'totalQuestoes', 0, 500)
          && optionalNumberBetween(summary, 'totalAcertos', 0, 500)
          && summary.get('totalAcertos', 0) <= summary.get('totalQuestoes', 500)
        );
    }

    function simulationIsSafe(userId) {
      let data = request.resource.data;
      let questions = data.get('totalQuestoes', data.get('questoesFeitas', 0));
      let correct = data.get('totalAcertos', data.get('acertos', 0));
      return academicIdentityIsSafe(data, userId)
        && academicDateIsSafe(data)
        && simulationSummaryIsSafe(data)
        && optionalNumberBetween(data, 'durationMinutes', 0, 720)
        && optionalNumberBetween(data, 'duracaoMinutos', 0, 720)
        && optionalNumberBetween(data, 'tempoEstudadoMinutos', 0, 720)
        && optionalNumberBetween(data, 'totalQuestoes', 0, 500)
        && optionalNumberBetween(data, 'questoesFeitas', 0, 500)
        && optionalNumberBetween(data, 'totalAcertos', 0, 500)
        && optionalNumberBetween(data, 'acertos', 0, 500)
        && correct <= questions
        && optionalString(data, 'nome', 240)
        && optionalString(data, 'titulo', 240)
        && optionalString(data, 'categoria', 120);
    }

    function goalIsSafe(userId) {
      let data = request.resource.data;
      return academicIdentityIsSafe(data, userId)
        && optionalNumberBetween(data, 'hours', 0, 24)
        && optionalNumberBetween(data, 'questions', 0, 500)
        && optionalString(data, 'startDate', 10)
        && optionalString(data, 'name', 200);
    }

    function cycleIsSafe(userId) {
      let data = request.resource.data;
      return academicIdentityIsSafe(data, userId)
        && optionalString(data, 'nome', 240)
        && optionalNumberBetween(data, 'conclusoes', 0, 10000)
        && optionalNumberBetween(data, 'tempoSessaoMinutos', 1, 720)
        && optionalListSize(data, 'ordemSessoes', 1000)
        && optionalListSize(data, 'sessoesConcluidas', 1000);
    }

    function scheduleIsSafe(userId) {
      let data = request.resource.data;
      return academicIdentityIsSafe(data, userId)
        && optionalString(data, 'nome', 240)
        && optionalNumberBetween(data, 'totalSemanas', 0, 520)
        && optionalNumberBetween(data, 'totalSemanasNecessarias', 0, 520)
        && optionalListSize(data, 'semanaTemplate', 1000)
        && optionalListSize(data, 'disciplinasSnapshot', 1000);
    }

    function cycleRoundCreateIsSafe(userId, cycleId) {
      let cyclePath = /databases/$(database)/documents/users/$(userId)/ciclos/$(cycleId);
      let beforeCycle = get(cyclePath).data;
      let afterCycle = getAfter(cyclePath).data;
      let roundNumber = request.resource.data.get('numeroRodada', 0);
      return roundNumber is int
        && roundNumber == beforeCycle.get('conclusoes', 0) + 1
        && afterCycle.get('conclusoes', 0) == roundNumber
        && request.resource.data.get('fechamentoReal', null) == request.time
        && request.resource.data.get('criadoEm', null) == request.time
        && optionalString(request.resource.data, 'inicioPlanejado', 10)
        && optionalString(request.resource.data, 'fechamentoIdeal', 10)
        && optionalString(request.resource.data, 'fechamentoRealData', 10)
        && optionalNumberBetween(request.resource.data, 'atrasoDias', 0, 3650)
        && optionalNumberBetween(request.resource.data, 'cargaPlanejadaMinutos', 0, 10080)
        && optionalNumberBetween(request.resource.data, 'cargaCumpridaAteDataIdealMinutos', 0, 10080)
        && optionalListSize(request.resource.data, 'materiasPendentesNoVencimento', 500);
    }

    // Estado de conta e acesso administrativo são alterados apenas pelo backend.
    function adminUserDocTouchedKeysAreSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'access',
        'accessUpdatedAt',
        'accessUpdatedBy',
        'status',
        'disabled',
        'statusUpdatedAt',
        'statusUpdatedBy'
      ]);
    }

    // Campos permitidos na criação do documento principal do usuário.
    function ownerUserDocCreateHasSafeKeys() {
      return request.resource.data.keys().hasOnly([
        'access',
        'createdAt',
        'displayName',
        'email',
        'name',
        'photoURL',
        'coverURL',
        'coverPosition',
        'studyStats',
        'uid',
        'updatedAt'
      ]);
    }

    // Impede que o próprio usuário se promova via campo access durante a criação.
    function ownerUserDocHasSafeAccess() {
      return !request.resource.data.keys().hasAny(['access'])
        || (
          request.resource.data.access.role == 'student'
          && request.resource.data.access.adminRole == null
          && request.resource.data.access.permissions.adminPanel != true
          && request.resource.data.access.permissions.manageBroadcasts != true
          && request.resource.data.access.permissions.manageTemplates != true
          && request.resource.data.access.permissions.viewAdminAnalytics != true
        );
    }

    // Verifica se um chamado de suporte existe.
    function feedbackExists(feedbackId) {
      return exists(/databases/$(database)/documents/system_feedback/$(feedbackId));
    }

    // Verifica se o chamado de suporte pertence ao usuário autenticado.
    function isFeedbackOwner(feedbackId) {
      return isSignedIn()
        && feedbackExists(feedbackId)
        && get(/databases/$(database)/documents/system_feedback/$(feedbackId)).data.uid == request.auth.uid;
    }

    // Dados globais do sistema: leitura para autenticados e gestão exclusiva do admin.
    match /system_broadcasts/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /editais_templates/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /system_quotes/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Métricas de consumo de IA são gravadas exclusivamente pelas Cloud Functions.
    match /system_ai_usage/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;

      match /calls/{callId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /system_ai_failures/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system_cache_errors/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system_news_cache_usage/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system_upload_usage/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Cache compartilhado: usuarios autenticados podem ler; somente admin pode popular/alterar.
    // Evita que um cliente comum contamine dados exibidos para outros usuarios.
    match /noticiaCache/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /time_sync/{docId} {
      allow read, create, update, delete: if isSignedIn()
        && docId.matches('^' + request.auth.uid + '(_.*)?$');
    }

    // Estado do timer ao vivo: o dono escreve apenas o próprio timer e o admin pode monitorar.
    match /active_timers/{uid} {
      allow read: if isOwnerOrAdmin(uid) || sharesStudyGroup(uid);
      allow create, update, delete: if isOwner(uid);
    }

    // Rankings são agregados exclusivamente pelas Cloud Functions.
    match /weekly_rankings/{weekId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update, delete: if false;
      }

      match /cohorts/{cohortId} {
        allow read: if isSignedIn();
        allow create, update, delete: if false;

        match /members/{memberId} {
          allow read: if isSignedIn();
          allow create, update, delete: if false;
        }
      }

      match /league_states/{leagueId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }

      match /system/{documentId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    // Vitrine sanitizada: pode ser consultada por qualquer usuário autenticado,
    // mas somente o backend projeta os campos públicos dos grupos.
    match /study_group_directory/{groupId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // O convite revela apenas o identificador e o nome necessários para
    // ingressar; o conteúdo do grupo privado continua restrito aos membros.
    match /study_group_invites/{inviteCode} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.ownerId == request.auth.uid
        );
    }

    match /study_groups/{groupId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.visibility == 'public')
        || isGroupMember(groupId);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility in ['public', 'private'];
      allow update: if isGroupManager(groupId) && groupManagerUpdateIsSafe();
      allow delete: if isGroupOwner(groupId);

      match /members/{memberId} {
        allow read: if isAdmin() || isGroupMember(groupId);
        allow create: if (
            isOwner(memberId)
            && request.resource.data.uid == request.auth.uid
            && newGroupMemberRoleIsSafe(groupId)
            && (
              getAfter(groupPath(groupId)).data.ownerId == request.auth.uid
              || (
                getAfter(groupPath(groupId)).data.visibility == 'public'
                && request.resource.data.joinSource == 'public'
              )
            )
          )
          || isGroupOwner(groupId);
        allow update: if (
            isGroupOwner(groupId)
            && memberId != get(groupPath(groupId)).data.ownerId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'permissions', 'updatedAt'])
            && (
              (
                request.resource.data.role == 'vice_leader'
                && request.resource.data.permissions.get('manageGroup', false) == true
                && request.resource.data.permissions.get('manageMembers', false) == true
              )
              || (
                request.resource.data.role == 'member'
                && request.resource.data.permissions.get('manageGroup', false) == false
                && request.resource.data.permissions.get('manageMembers', false) == false
              )
            )
          )
          || (
            isOwner(memberId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.permissions == resource.data.permissions
          );
        allow delete: if (isGroupOwner(groupId) && memberId != get(groupPath(groupId)).data.ownerId)
          || (
            isGroupMemberManager(groupId)
            && memberId != get(groupPath(groupId)).data.ownerId
            && resource.data.role == 'member'
          )
          || (isOwner(memberId) && memberId != get(groupPath(groupId)).data.ownerId);
      }

      match /join_requests/{requestUserId} {
        allow read: if isAdmin() || isOwner(requestUserId) || isGroupMemberManager(groupId);
        allow create: if isOwner(requestUserId)
          && get(groupPath(groupId)).data.visibility == 'private'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isGroupMemberManager(groupId);
        allow delete: if isOwner(requestUserId) || isGroupMemberManager(groupId);
      }

      match /weekly_rankings/{weekId} {
        allow read: if isAdmin()
          || (isSignedIn() && get(groupPath(groupId)).data.visibility == 'public')
          || isGroupMember(groupId);
        allow create, update, delete: if false;

        match /members/{memberId} {
          allow read: if isAdmin()
            || (isSignedIn() && get(groupPath(groupId)).data.visibility == 'public')
            || isGroupMember(groupId);
          allow create, update, delete: if false;
        }
      }

      match /monthly_rankings/{monthId} {
        allow read: if isAdmin()
          || (isSignedIn() && get(groupPath(groupId)).data.visibility == 'public')
          || isGroupMember(groupId);
        allow create, update, delete: if false;

        match /members/{memberId} {
          allow read: if isAdmin()
            || (isSignedIn() && get(groupPath(groupId)).data.visibility == 'public')
            || isGroupMember(groupId);
          allow create, update, delete: if false;
        }
      }
    }

    match /general_rankings/{rankingId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Consultas transversais usadas exclusivamente pelo painel administrativo.
    match /{path=**}/registrosEstudo/{recordId} {
      allow read: if isAdmin();
    }

    match /{path=**}/simulados/{simuladoId} {
      allow read: if isAdmin();
    }

    match /{path=**}/ciclos/{cicloId} {
      allow read: if isAdmin();
    }

    match /{path=**}/cronogramas/{cronogramaId} {
      allow read: if isAdmin();
    }

    // Necessário para a visão consolidada de usuários do admin. Escritas continuam
    // regidas pelo caminho específico e nunca são liberadas por este matcher.
    match /{path=**}/gamification/{profileId} {
      allow read: if isAdmin();
    }

    // Documento principal do usuário e todas as subcoleções permanecem restritos ao dono ou admin.
    match /users/{userId} {
      allow create: if (
          isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && ownerUserDocCreateHasSafeKeys()
          && ownerUserDocHasSafeAccess()
          && ownerUserDocFieldsAreSafe(userId)
          && initialStudyStatsAreSafe()
        );
      allow read: if isOwnerOrAdmin(userId);
      allow update: if (isAdmin() && adminUserDocTouchedKeysAreSafe())
        || (
          isOwner(userId)
          && ownerUserDocTouchedKeysAreSafe()
          && ownerUserDocFieldsAreSafe(userId)
          && (
            !request.resource.data.keys().hasAny(['uid'])
            || request.resource.data.uid == userId
          )
        );
      allow delete: if false;

      match /gamification/profile {
        allow read: if isOwnerOrAdmin(userId);
        allow create: if (
            isOwner(userId)
            && gamificationProfileCreateKeysAreSafe()
            && gamificationProfileCreateGroupsAreSafe(userId)
            && gamificationMainGroupIsSafe(userId)
          );
        allow update: if (
            isOwner(userId)
            && gamificationProfileUpdateKeysAreSafe()
            && gamificationProfileUpdateGroupsAreSafe(userId)
            && gamificationMainGroupUpdateIsSafe(userId)
          )
          || gamificationProfileManagerRemovalIsSafe(userId);
        allow delete: if false;

        match /achievements/{achievementId} {
          allow read: if isOwnerOrAdmin(userId);
          allow create, update, delete: if false;
        }

        match /xp_events/{eventId} {
          allow read: if isOwnerOrAdmin(userId);
          allow create, delete: if false;
          allow update: if isOwner(userId) && xpEventReadStateUpdateIsSafe();
        }
      }

      match /notifications/{notificationId} {
        allow read: if isOwnerOrAdmin(userId);
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (isOwner(userId) && notificationReadStateUpdateIsSafe());
      }

      match /registrosEstudo/{recordId} {
        allow read: if isOwnerOrAdmin(userId);
        allow create, update: if isOwner(userId) && studyRecordIsSafe(userId);
        allow delete: if isOwner(userId);
      }

      match /simulados/{simulationId} {
        allow read: if isOwnerOrAdmin(userId);
        allow create, update: if isOwner(userId) && simulationIsSafe(userId);
        allow delete: if isOwner(userId);
      }

      match /metas/{goalId} {
        allow read: if isOwnerOrAdmin(userId);
        allow create, update: if isOwner(userId) && goalIsSafe(userId);
        allow delete: if isOwner(userId);
      }

      match /ciclos/{cycleId} {
        allow read: if isOwnerOrAdmin(userId);
        allow create, update: if isOwner(userId) && cycleIsSafe(userId);
        allow delete: if isOwner(userId);

        match /rodadas/{roundId} {
          allow read: if isOwnerOrAdmin(userId);
          allow create: if isOwner(userId) && cycleRoundCreateIsSafe(userId, cycleId);
          allow update: if false;
          allow delete: if isOwner(userId);
        }

        match /{nestedCollection}/{nestedDocument=**} {
          allow read: if nestedCollection != 'rodadas' && isOwnerOrAdmin(userId);
          allow write: if nestedCollection != 'rodadas' && isOwner(userId);
        }
      }

      match /cronogramas/{scheduleId} {
        allow read: if isOwnerOrAdmin(userId);
        allow create, update: if isOwner(userId) && scheduleIsSafe(userId);
        allow delete: if isOwner(userId);

        match /{nestedCollection}/{nestedDocument=**} {
          allow read: if isOwnerOrAdmin(userId);
          allow write: if isOwner(userId);
        }
      }

      // Exige ao menos uma subcoleção e um documento; o wildcard recursivo
      // sozinho também casaria o documento users/{userId} em rules_version 2.
      match /{subCollection}/{document=**} {
        allow read, write, delete: if subCollection != 'gamification'
          && subCollection != 'notifications'
          && subCollection != 'registrosEstudo'
          && subCollection != 'simulados'
          && subCollection != 'metas'
          && subCollection != 'ciclos'
          && subCollection != 'cronogramas'
          && isOwnerOrAdmin(userId);
      }
    }

    // Chamados de suporte:
    // o dono pode abrir e ler o próprio chamado;
    // o admin pode ler e gerenciar toda a fila.
    match /system_feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      // Atualizações do dono ficam restritas aos campos usados pelo widget atual.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'adminTyping',
            'lastUpdate',
            'unreadAdmin',
            'unreadUser',
            'userTyping'
          ])
        );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || isFeedbackOwner(feedbackId);

        // O dono pode enviar apenas mensagens de usuario no proprio chamado.
        // Mensagens admin/system ficam restritas ao painel/admin.
        allow create: if isAdmin()
          || (
            isFeedbackOwner(feedbackId)
            && request.resource.data.sender == 'user'
          );

        allow update, delete: if isAdmin();
      }
    }

    // Negação padrão para qualquer caminho não coberto explicitamente acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
